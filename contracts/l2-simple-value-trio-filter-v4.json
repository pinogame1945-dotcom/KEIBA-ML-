{
  "contract": "L2_SIMPLE_VALUE_TRIO_FILTER_V4",
  "purpose": "Keep GAP1 value-axis and probability-only ticket ranking, then use market only as transparent post-ranking filters: acceptable axis rank zone and minimum TRIO odds.",
  "years": [2022, 2023, 2024, 2025],
  "folds": {"2023":[2022],"2024":[2022,2023],"2025":[2022,2023,2024]},
  "axis_policy": {
    "base_value_candidate": "market_rank - consensus_rank >= 1",
    "base_selection": "highest existing walk-forward p3; ties unchanged",
    "zone_search": {
      "king_rank_max": [1,2,3],
      "market_rank_min": [2,3,4],
      "market_rank_max": [5,6,7]
    }
  },
  "ticket_policy": {
    "probability_rank_frozen_before_market_filter": true,
    "topk": [1,3,5,8,12],
    "trio_odds_floor": [0,10,20,30,40,50],
    "probability_times_odds": false,
    "odds_can_promote_ticket": false,
    "low_odds_ticket_replacement": false
  },
  "walk_forward_policy_selection": {
    "fit_fraction": 0.70,
    "probability_calibration_fraction": 0.15,
    "rule_selection_fraction": 0.15,
    "minimum_rule_selection_coverage_pct_each_half": 60,
    "objective": "maximize minimum ROI across two chronological rule-selection halves, then pooled ROI",
    "test_year_never_used_for_rule_selection": true
  },
  "evaluation": {
    "stake_per_ticket_yen": 100,
    "staking_optimization": false
  },
  "cost_policy": {
    "github_standard_cpu_only": true,
    "gpu": false,
    "paid_artifact_or_cache": false,
    "paid_cloud_compute": false
  },
  "data_policy": {
    "kaggle_metadata_first": true,
    "404_retry": false,
    "2026_locked": true
  }
}
