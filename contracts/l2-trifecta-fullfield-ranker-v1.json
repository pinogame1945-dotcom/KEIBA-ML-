{
  "contract": "L2_TRIFECTA_FULLFIELD_RANKER_V1",
  "purpose": "Remove the Seven-King Top6 candidate-universe limit and score every priced full-field trifecta ticket.",
  "years": [2022, 2023, 2024, 2025],
  "development_years": [2023, 2024],
  "holdout_year": 2025,
