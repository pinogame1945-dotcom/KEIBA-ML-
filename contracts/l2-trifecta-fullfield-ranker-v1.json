  "invariants": {
    "rerank_l1": false,
    "outsider_used": false,
    "gate_used": false,
    "payout_as_model_feature": false,
    "finish_result_as_model_feature": false,
    "holdout_used_for_policy_selection": false,
    "2026_used": false,
    "production_promotion": false
  },
  "cost": {
    "standard_github_cpu_only": true,
    "gpu": false,
    "paid_runner": false,
    "github_artifact": false,
    "github_cache": false,
    "persistent_kaggle_upload": false,
    "kaggle_existing_datasets_read_only": true,
    "full_candidate_matrices_ephemeral": true
  }
