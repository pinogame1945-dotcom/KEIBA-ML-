{
  "contract": "L2_TRIO_MARKET_GAP_V0",
  "version": 1,
  "purpose": "Research TRIO as an independent L2 market. Generate every priced 3-horse combination, compare market ranking, pure L1.7 trio ranking, and a market-aware LambdaRank model. V0 must not search or promote LAW rules.",
  "bet_type": "TRIO",
  "input_years": [2021, 2022, 2023, 2024, 2025],
  "test_years": [2022, 2023, 2024, 2025],
  "candidate_generation": {
    "all_runners": true,
    "all_three_horse_combinations": true,
    "top_k_horse_filter": false,
    "ordered_finish": false
  },
  "target": "Actual payable TRIO combination from race payout data; dead-heat payable combinations remain valid positives.",
  "market": {
    "probability": "(1 / trio_odds) / sum_race(1 / trio_odds)",
    "features": ["market_q_norm", "market_log_q", "market_rank"],
    "raw_ev_multiplication": false
  },
  "rankings": [
    "MARKET",
    "L17_TRIO_PRODUCT",
    "MARKET_AWARE_MODEL"
  ],
  "value_diagnostic": "rank_upgrade = market_rank - model_rank",
  "required_top_k": [1, 3, 5, 10, 20, 50, 100],
  "research_boundaries": {
    "law_search": false,
    "ticket_selection_policy": false,
    "l3_handoff": false,
    "roi_is_selection_objective": false,
    "2026_outcomes_locked": true
  },
  "required_diagnostics": [
    "ranking coverage by year",
    "winner market/model/L1.7 ranks",
    "winner rank-upgrade distribution",
    "market-vs-model winner rank matrix",
    "model-only versus market-only captures at Top5/10/20/50",
    "winning trio L1.7 rank composition",
    "feature importance"
  ],
  "cost": {
    "standard_github_cpu_only": true,
    "gpu": false,
    "github_artifact": false,
    "github_cache": false,
    "persistent_external_storage_write": false
  }
}
